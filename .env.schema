# 開発用スタックの環境変数。varlock が検証してから docker compose に注入する。
#
#   mise run up      # = varlock run -- docker compose up -d
#   varlock load     # 検証して中身を見る (sensitive は伏せられる)
#
# 値の優先順は「プロセスの環境変数 > .env > ここに書いた値」。
# ここにあるのは開発機用の使い捨ての既定値で、本番では必ず上書きする。
# .env は git 管理外 (.gitignore 済み)。
#
# 詳細は README.md の「環境変数」を参照。

# --- postgres ---

# データベース名
# @public
POSTGRES_DB=jvdata

# ホスト側 (psql / pgAdmin) が使う管理用ロール
# @public
POSTGRES_USER=jvdata

# 管理用ロールのパスワード
#
# 値は repo に置かない。開発機の分は mise run env:init が .env にランダムで作る。
# 本番は環境変数か secret manager から渡す。
# @required
# @sensitive
POSTGRES_PASSWORD=

# wine コンテナの中の 32-bit プロセスが使う収集用ロールのパスワード
# @required
# @sensitive
POSTGRES_LOADER_PASSWORD=

# postgres_exporter と Grafana が使う統計読み取りロールのパスワード
# @required
# @sensitive
POSTGRES_METRICS_PASSWORD=

# wine コンテナから見た PostgreSQL。別ホストの DB を使うときだけ上書きする
# (例: host.docker.internal / 15432 に SSH ポート転送している場合)。
# @public
POSTGRES_HOST=postgres

# @public
POSTGRES_PORT=5432

# --- grafana ---

# Grafana の管理ユーザー (admin) のパスワード
# @required
# @sensitive
GF_ADMIN_PASSWORD=

# --- pgadmin ---

# @public
PGADMIN_EMAIL=jvdata@example.com

# @required
# @sensitive
PGADMIN_PASSWORD=

# --- tailscale ---

# このマシンの MagicDNS 名。UI を HTTPS で出すときの URL と証明書の名前になる。
# 取得方法: tailscale status --json | python3 -c \
#   "import sys,json; print(json.load(sys.stdin)['Self']['DNSName'].rstrip('.'))"
# マシンを変えるときは .env で上書きする (ここは開発機の既定値)。
# @public
TS_FQDN=hermes.tailab18f3.ts.net

# --- jvdata CLI / bridge ---

# JVInit に渡すソフトウェア ID。JRA-VAN から発行された SID がある場合だけ
# 上書きする (なければ UNKNOWN で動く)。
# @public
JVDATA_SID=UNKNOWN

# bridge を実行する wine コンテナ名
# @public
JVDATA_WINE_CONTAINER=jvdata-pipeline-wine-1

# raw の取得元 ("wine" / "fixture:DIR" / 任意の bridge コマンド文字列)
# @public
JVDATA_SOURCE=wine

# ダウンロード停滞検出の上限秒数 (JVStatus の進捗がこの時間無いと失敗)
# @public
JVDATA_STALL_SECS=600
