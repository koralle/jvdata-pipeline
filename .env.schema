# 開発用スタックの環境変数。varlock が検証してから docker compose に注入する。
#
#   mise run up      # = varlock run -- docker compose up -d
#   varlock load     # 検証して中身を見る (sensitive は伏せられる)
#
# 値の優先順は「プロセスの環境変数 > .env > ここに書いた値」。
# ここにあるのは開発機用の使い捨ての既定値で、本番では必ず上書きする。
# .env は git 管理外 (.gitignore 済み)。
#
# 詳細は README.md の「環境変数」を参照。

# --- postgres ---

# データベース名
#
# NOTE: provisioning 済みファイル (docker/pgadmin/servers.json、
# Grafana の postgres datasource、ダッシュボードの datname= クエリ) にも
# "jvdata" が書き込まれている。変えるならそれらも合わせて書き換えること。
# @public
POSTGRES_DB=jvdata

# ホスト側 (psql / pgAdmin) が使う管理用ロール
#
# NOTE: POSTGRES_DB と同じく provisioning 済みファイルに "jvdata" が
# 書き込まれている (servers.json の Username、本番は pg_hba.conf の
# replication 行)。変えるならそれらも合わせて書き換えること。
# @public
POSTGRES_USER=jvdata

# 管理用ロールのパスワード
#
# 値は repo に置かない。開発機の分は mise run env:init が .env にランダムで作る。
# 本番は環境変数か secret manager から渡す。
# @required
# @sensitive
POSTGRES_PASSWORD=

# wine コンテナの中の 32-bit プロセスが使う収集用ロールのパスワード
# @required
# @sensitive
POSTGRES_LOADER_PASSWORD=

# postgres_exporter と Grafana が使う統計読み取りロールのパスワード
# @required
# @sensitive
POSTGRES_METRICS_PASSWORD=

# wine / dbtools コンテナから見た PostgreSQL。別ホストの DB を使うときだけ
# 上書きする (例: host.docker.internal / 15432 に SSH ポート転送している場合)。
# @public
POSTGRES_HOST=postgres

# @public
POSTGRES_PORT=5432

# --- grafana ---

# Grafana の管理ユーザー (admin) のパスワード
# @required
# @sensitive
GF_SECURITY_ADMIN_PASSWORD=

# --- pgadmin ---

# @public
PGADMIN_EMAIL=jvdata@example.com

# @required
# @sensitive
PGADMIN_PASSWORD=
