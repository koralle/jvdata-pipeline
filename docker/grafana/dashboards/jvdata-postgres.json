      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawSql": "select relname,\n       n_live_tup, n_dead_tup, n_mod_since_analyze,\n       vacuum_count, autovacuum_count, analyze_count, autoanalyze_count,\n       last_vacuum, last_autovacuum, last_analyze, last_autoanalyze\nfrom pg_stat_user_tables\norder by n_dead_tup desc\nlimit 20"
        }
