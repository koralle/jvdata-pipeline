      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(pg_stat_activity_count{datname=\"jvdata\"}) / sum(pg_settings_max_connections)",
          "legendFormat": "使用率"
