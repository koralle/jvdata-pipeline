# 本番用スタックの環境変数。
#
#   varlock run -- docker compose up -d
#
# 開発用の .env.schema と違ってパスワードには既定値が無い。未設定なら varlock が
# 止めるので、空のパスワードで起動することはない。
#
# 値の出どころは環境変数 (systemd の EnvironmentFile、secret manager の CLI など)
# か、mode 600 の .env。詳細は deploy/production/README.md。

# --- postgres ---

# @public
POSTGRES_DB=jvdata

# @public
POSTGRES_USER=jvdata

# 管理用ロールのパスワード
# @required
# @sensitive
POSTGRES_PASSWORD=

# 収集用ロール (wine コンテナの中の 32-bit プロセス) のパスワード
# @required
# @sensitive
POSTGRES_LOADER_PASSWORD=

# 監視用ロール (postgres_exporter / Grafana) のパスワード
# @required
# @sensitive
POSTGRES_METRICS_PASSWORD=

# @public
POSTGRES_HOST=postgres

# @public
POSTGRES_PORT=5432

# --- grafana ---

# @required
# @sensitive
GF_SECURITY_ADMIN_PASSWORD=
